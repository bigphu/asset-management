# Copy to .env.local to override for your machine (.env.local is gitignored).

# Base path the browser calls. Keep `/api`: in dev Vite proxies it (see
# vite.config.ts), behind the gateway nginx proxies it — same origin, no CORS.
VITE_API_URL=/api

# Where the Vite dev server forwards /api. Point it at the gateway
# (http://localhost:8080) to exercise nginx instead of Express directly.
API_PROXY_TARGET=http://localhost:3000
