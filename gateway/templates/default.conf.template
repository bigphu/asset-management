# Rendered by the nginx image's envsubst step. Only ${API_UPSTREAM} is
# substituted (nginx's own $variables are left alone because they are not
# set in the environment).

upstream api_backend {
    server ${API_UPSTREAM};
    keepalive 16;
}

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Gateway's own liveness probe; does not touch the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- API gateway ---------------------------------------------------------
    # /api/* is forwarded with its prefix intact: the backend mounts its router
    # at /api (backend/api/index.js), so public and internal paths match.
    location /api/ {
        proxy_pass         http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Request-ID      $request_id;

        # Excel exports are built synchronously (ADR-0007); ADR says revisit
        # past ~3 s, so 60 s is a hard ceiling, not an expected duration.
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
        client_max_body_size  1m;

        # API responses are never cached by the browser or intermediaries.
        add_header Cache-Control "no-store" always;
    }

    # Backend down or restarting -> answer in the API's own error envelope so
    # the frontend's apiClient can still parse it.
    error_page 502 503 504 = @api_unavailable;
    location @api_unavailable {
        default_type application/json;
        return 503 '{"error":{"code":"API_UNAVAILABLE","message":"The API is unavailable. Try again shortly."}}';
    }

    # --- SPA -----------------------------------------------------------------
    # Vite emits content-hashed files under /assets/, safe to cache forever.
    # (No app route lives under /assets — the inventory page is /inventory.)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/inventory, /export-profiles, …) fall back to the
    # shell. index.html itself must revalidate so new deploys are picked up.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
