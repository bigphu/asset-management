# Copy file này thành .env rồi chỉnh giá trị cho môi trường local.
# .env đã nằm trong .gitignore, không commit.

# Express server
PORT=3000

# PostgreSQL (khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_management
DB_USER=asset_app
DB_PASSWORD=asset_app_dev
DB_POOL_MAX=10

# Tài khoản mặc định ghi nhận mọi thao tác cho đến khi có story xác thực
# (xem api/middleware/currentUser.js). Tự tạo ở request đầu tiên.
DEFAULT_USER_EMAIL=asset.manager@asset-management.local
DEFAULT_USER_NAME=Asset Manager

# JWT (đổi thành chuỗi ngẫu nhiên khi chạy thật)
JWT_SECRET=change-me-in-local-env
